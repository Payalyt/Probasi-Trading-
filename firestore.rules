rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if true;
    }
    match /trades/{tradeId} {
      allow read, write: if true;
    }
    match /deposits/{depositId} {
      allow read, write: if true;
    }
    match /withdrawals/{withdrawalId} {
      allow read, write: if true;
    }
    match /settings/{docId} {
      allow read, write: if true;
    }
    match /gateways/{docId} {
      allow read, write: if true;
    }
  }
}
